# GEMINI_API_KEY: Required if expanding with Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Set to "production" in production deployments
NODE_ENV="development"

# (Optional) External Notification Webhook / CRM Integration
# Example: SendGrid, Postmark, or HubSpot webhook for lead intake notifications
TARODA_CRM_WEBHOOK_URL=""
TARODA_NOTIFY_EMAIL="security@taroda.com"
